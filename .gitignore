# ── mumax-bridge (Go + CUDA) ───────────────────────────────────────────
# mumax3 source is cloned here at build time — do not commit it.
# No trailing slash: on some machines this is a symlink, which a
# directory-only pattern ("/mumax3-src/") would NOT match.
/mumax3-src

# Build output and NVIDIA runtime DLLs are not included (size / user-built)
mumax-bridge/mumax-bridge.exe
mumax-bridge/*.dll
mumax-bridge/bridge.out/

# mumax simulation output (regenerable)
mumax-bridge/scripts/*.out/
*.out/

# ── repo-local notes (not for publication) ─────────────────────────────
