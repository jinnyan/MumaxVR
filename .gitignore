docs/mumaxvr_ledger.html

# TextMesh Pro "Examples & Extras" — unused by MumaxVR, contains fonts with
# unclear licensing; keep it out of the repository
/Assets/TextMesh Pro/Examples & Extras/
/Assets/TextMesh Pro/Examples & Extras.meta

